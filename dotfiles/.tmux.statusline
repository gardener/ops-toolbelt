set -g status "on"
set -g status-justify "centre"
set -g status-bg "colour255"
set -g status-left-length "100"
set -g status-right-length "100"
set -g message-style "fg=colour15,bg=colour39"
set -g message-command-style "fg=colour15,bg=colour39"
set -g pane-border-style "fg=colour39"
set -g pane-active-border-style "fg=colour33"
setw -g window-status-style "fg=colour16,bg=colour255"
setw -g window-status-activity-style "fg=colour33,bg=colour255,none"
setw -g window-status-separator ""
set -g status-left "#[fg=colour15,bg=colour33] #(cat \"$DOTFILES_HOME/.host_alias\") #[fg=colour33,bg=colour39,nobold,nounderscore,noitalics]#[fg=colour15,bg=colour39] #S #[fg=colour39,bg=colour255,nobold,nounderscore,noitalics]"
set -g status-right "#[fg=colour39,bg=colour255,nobold,nounderscore,noitalics]#[fg=colour15,bg=colour39] %H:%M #[fg=colour33,bg=colour39,nobold,nounderscore,noitalics]#[fg=colour15,bg=colour33] %Y-%m-%d "
setw -g window-status-format "#[fg=colour255,bg=colour255,nobold,nounderscore,noitalics]#[default]    #W    #[fg=colour255,bg=colour255,nobold,nounderscore,noitalics]"
setw -g window-status-current-format "#[fg=colour255,bg=colour39,nobold,nounderscore,noitalics]#[fg=colour15,bg=colour39]    #W    #[fg=colour39,bg=colour255,nobold,nounderscore,noitalics]"
