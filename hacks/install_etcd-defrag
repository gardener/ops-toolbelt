set -eo pipefail

# renovate: datasource=github-releases depName=ahrtr/etcd-defrag
ETCD_DEFRAG_VERSION="v0.48.0"
# sha256 of etcd-defrag-<version>-linux-<arch>.tar.gz for ETCD_DEFRAG_VERSION (from the release's SHA256SUMS).
# Refresh both whenever ETCD_DEFRAG_VERSION changes.
ETCD_DEFRAG_SHA256_AMD64="883d2406283754977e221008a440b72058ab3e38725fb09e627098a0cb1d6b67"
ETCD_DEFRAG_SHA256_ARM64="24100ad0fd111ed826407e6ae9999a9954ee3f5167c33f91a2861b8c4ef1e20b"

function show_help () {
  echo "Usage: ${0} [arguments]"
  echo "Possible arguments:"
  echo "-h, --help       Show this help message and exit"
  echo "-v, --version    Optional: specify etcd-defrag version to use. Default: pinned ${ETCD_DEFRAG_VERSION}"
  echo "Environment:"
  echo "OPS_TOOLBELT_BIN_DIR  Optional: install into this directory (ops-pod --chroot sets it to a per-pod directory)"
}

# Prints the expected sha256 of release asset ${2} for version ${1} on arch ${3}.
# The pinned version uses the embedded digests; any other version falls back to
# the checksum file published with that release.
function expected_sha256 () {
  local version=$1
  local asset=$2
  local arch=$3

  if [[ "${version}" == "${ETCD_DEFRAG_VERSION}" ]]; then
    case "${arch}" in
      amd64) echo "${ETCD_DEFRAG_SHA256_AMD64}" ;;
      arm64) echo "${ETCD_DEFRAG_SHA256_ARM64}" ;;
    esac
    return
  fi

  echo "etcd-defrag ${version} is not the pinned version (${ETCD_DEFRAG_VERSION}); verifying against the release's SHA256SUMS" >&2
  curl -fsSL "https://github.com/ahrtr/etcd-defrag/releases/download/${version}/SHA256SUMS" \
    | awk -v f="${asset}" '$2 == f || $2 == "*" f { print $1 }'
}

function install () {
  local version="${1:-${ETCD_DEFRAG_VERSION}}"
  local download_url
  local arch
  local platform
  local pkg
  local dest
  local sha256
  local yellow="\033[0;33m"
  local nc="\033[0m"

  # Global, not local: the EXIT trap runs after install() has returned.
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT
  mkdir -p "${tmp_dir}/dest"

  dest="/opt/bin/etcd-defrag"
  if [[ -n "${OPS_TOOLBELT_BIN_DIR}" ]]; then
    dest="${OPS_TOOLBELT_BIN_DIR}/etcd-defrag"
  elif [[ "$(id -u)" == 0 && -w /usr/local/bin ]]; then
    dest="/usr/local/bin/etcd-defrag"
  fi

  if [[ ! $version == v* ]]; then
    version="v${version}"
  fi

  arch=$(uname -m | sed 's/^x86_64$/amd64/;s/^aarch64$/arm64/')

  platform="$(uname -s | tr '[:upper:]' '[:lower:]')"
  pkg="etcd-defrag-${version}-${platform}-${arch}"

  sha256="$(expected_sha256 "${version}" "${pkg}.tar.gz" "${arch}")"
  if [ -z "${sha256}" ]; then
    echo "No sha256 known for ${pkg}.tar.gz of etcd-defrag ${version}; refusing to install." >&2
    exit 1
  fi

  download_url="https://github.com/ahrtr/etcd-defrag/releases/download/${version}/${pkg}.tar.gz"

  curl -fsSL "${download_url}" -o "${tmp_dir}/${pkg}.tar.gz"
  echo "${sha256}  ${tmp_dir}/${pkg}.tar.gz" | sha256sum -c - >&2
  tar -zxf "${tmp_dir}/${pkg}.tar.gz" -C "${tmp_dir}/dest"
  mv "${tmp_dir}/dest/${pkg}/etcd-defrag" "${dest}"
  chmod 755 "${dest}"

  echo -e "${yellow}"
  echo "etcd-defrag ${version} installed. Accepts etcdctl defrag flags, checks health, and defragments the leader last."
  echo
  echo "  Preview all members: etcd-defrag --cluster --dry-run"
  echo "  Defragment:          etcd-defrag --cluster"
  echo "  Add --move-leader to transfer leadership before defragmenting the leader."
  echo "  Add --auto-disalarm to clear NOSPACE alarms below the quota threshold."
  echo "  For --auto-disalarm, set --etcd-storage-quota-bytes to etcd's --quota-backend-bytes."
  echo
  echo "Compaction runs by default; use --compaction=false to skip it."
  echo "The shell wrapper tries to detect TLS certificates and the endpoint in an etcd pod."
  echo "Otherwise, pass --cacert, --cert, --key and --endpoints explicitly."
  echo "Help: etcd-defrag --help | Pod examples: print-etcd-cheatsheet"
  echo "Docs: https://github.com/ahrtr/etcd-defrag"
  echo -e "${nc}"
}

case "$1" in
  --version | -v)
    install "$2"
    exit
    ;;
  --help | -h)
    show_help
    exit
    ;;
  *)
    install
    exit
    ;;
esac
