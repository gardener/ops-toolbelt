set -eo pipefail

ETCD_VERSION="v3.5.27"
# sha256 of etcd-<version>-linux-<arch>.tar.gz for ETCD_VERSION (from the release's SHA256SUMS).
# Refresh both whenever ETCD_VERSION changes.
ETCD_SHA256_AMD64="0aad9a9e4e0817a021e933f9806a2b2960a62f949ad5a3d6436d8886945cb1bc"
ETCD_SHA256_ARM64="1277309f540c5a0329c428f95455c9f76d24f768c8d28fd2753e891c379053fa"

function show_help () {
  echo "Usage: ${0} [arguments]"
  echo "Possible arguments:"
  echo "-h, --help       Show this help message and exit"
  echo "-v, --version    Optional: specify etcdctl version to use. Default: pinned ${ETCD_VERSION}"
}

# Prints the expected sha256 of release asset ${2} for version ${1} on arch ${3}.
# The pinned version uses the embedded digests; any other version falls back to
# the checksum file published with that release.
function expected_sha256 () {
  local version=$1
  local asset=$2
  local arch=$3

  if [[ "${version}" == "${ETCD_VERSION}" ]]; then
    case "${arch}" in
      amd64) echo "${ETCD_SHA256_AMD64}" ;;
      arm64) echo "${ETCD_SHA256_ARM64}" ;;
    esac
    return
  fi

  echo "etcd ${version} is not the pinned version (${ETCD_VERSION}); verifying against the release's SHA256SUMS" >&2
  curl -fsSL "https://github.com/etcd-io/etcd/releases/download/${version}/SHA256SUMS" \
    | awk -v f="${asset}" '$2 == f || $2 == "*" f { print $1 }'
}

function install () {
  local version="${1:-${ETCD_VERSION}}"
  local download_url
  local arch
  local platform
  local pkg
  local dest
  local sha256
  local yellow="\033[0;33m"
  local nc="\033[0m"

  # Global, not local: the EXIT trap runs after install() has returned.
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT
  mkdir -p "${tmp_dir}/dest"

  dest="/opt/bin/etcdctl"
  if [[ "$(id -u)" == 0 && -w /usr/local/bin ]]; then
    dest="/usr/local/bin/etcdctl"
  fi

  if [[ ! $version == v* ]]; then
    version="v${version}"
  fi

  arch=$(uname -m | sed 's/^x86_64$/amd64/;s/^aarch64$/arm64/')

  platform="$(uname -s | tr '[:upper:]' '[:lower:]')"
  pkg="etcd-${version}-${platform}-${arch}"

  sha256="$(expected_sha256 "${version}" "${pkg}.tar.gz" "${arch}")"
  if [ -z "${sha256}" ]; then
    echo "No sha256 known for ${pkg}.tar.gz of etcd ${version}; refusing to install." >&2
    exit 1
  fi

  download_url="https://github.com/etcd-io/etcd/releases/download/${version}/${pkg}.tar.gz"

  curl -fsSL "${download_url}" -o "${tmp_dir}/${pkg}.tar.gz"
  echo "${sha256}  ${tmp_dir}/${pkg}.tar.gz" | sha256sum -c - >&2
  tar -zxf "${tmp_dir}/${pkg}.tar.gz" -C "${tmp_dir}/dest"
  mv "${tmp_dir}/dest/${pkg}/etcdctl" "${dest}"
  chmod 755 "${dest}"

  echo -e "${yellow}"
  echo "You can now start using etcdctl. Just execute \"etcdctl\" to use it. See https://etcd.io/docs/v3.5/dev-guide/interacting_v3/ for more details."
  echo "This tool assumes that it is being run in an ephemeral container in a pod. If this is not the case, please ensure that you provide the correct certificates, the correct endpoint, and have all necessary accesses."
  echo "Certificates to be passed to the command should be mounted onto any container in the pod having a shared process namespace. Please run \"ps -A\" to list all processes and then access the certificates using \"/proc/<proc number>/root/<file-path>\". Pass these certificate file paths to the etcdctl command :)"
  echo -e "${nc}"
}

case "$1" in
  --version | -v)
    install "$2"
    exit
    ;;
  --help | -h)
    show_help
    exit
    ;;
  *)
    install
    exit
    ;;
esac
