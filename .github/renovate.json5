{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitsDisabled',
    'customManagers:githubActionsVersions',
    'group:monorepos',
  ],
  labels: [
    'kind/enhancement',
  ],
  prFooter: '**Release note**:\n```other dependency\nNONE\n```',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Makefile$/',
        '/\\.yaml$/',
        '/\\.sh$/',
        '/^hacks/*/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s.+?_(VERSION|version|IMAGE_TAG) *[?:]?= *"?(?<currentValue>.+?)"?\\s',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/common-components\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+version\\s*:\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
    },
  ],
  packageRules: [
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
    },
    {
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      enabled: true,
    },
    {
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      separateMinorPatch: true,
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      prFooter: '**Release note**:\n```other dependency\n`{{depName}}` has been updated to `{{newVersion}}`. [Release Notes](https://github.com/{{depName}}/releases/tag/{{newVersion}})\n```',
    },
  ],
}
