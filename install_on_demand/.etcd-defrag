alias etcd-defrag="etcd-defrag_install"
function etcd-defrag_install() {
  app="etcd-defrag"
  install_func='/nonroot/hacks/install_etcd-defrag'

  if ! hash "${app}" &>/dev/null; then
    "${install_func}" 1>&2
  fi
  # shellcheck disable=SC2046
  command "${app}" $(_etcdctl_prepend_args "$@")
}
